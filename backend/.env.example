# Application
APP_NAME=Multi Agent Orchestration System
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_agent_db

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120

# Agent Specific Models
MODEL_PLANNER=llama3.1:8b
MODEL_RESEARCH=llama3.1:8b
MODEL_CODER=qwen2.5-coder:7b
MODEL_TESTER=qwen2.5-coder:7b
MODEL_REVIEWER=llama3.1:8b

# AI Assistant
SYSTEM_PROMPT=You are a helpful AI assistant integrated into the Multi Agent Orchestration System. You provide clear, accurate, and well-structured responses. When writing code, use proper formatting with markdown code blocks. Be concise but thorough.
